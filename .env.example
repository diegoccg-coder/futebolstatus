# Copie para .env.local e ajuste (recomendado em produção)
NEXTAUTH_URL=http://localhost:3000
# Em produção (Vercel): use a URL pública exata do site, ex. https://seu-app.vercel.app
NEXTAUTH_SECRET=gere-uma-string-longa-aleatoria-aqui

# Supabase (ao subir para online, o app passa a persistir aqui)
# Ex.: https://tufhtbrqlrnmofxjxfir.supabase.co (confira no painel do projeto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca commitar. Só servidor / Vercel (não expor ao browser)
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: transcrição de voz no iPhone (Whisper). Comandos curtos ~US$ 0,001 cada.
OPENAI_API_KEY=
